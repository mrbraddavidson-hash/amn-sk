{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amn-sk-cms",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": [
    "nodejs_compat",
    "expose_global_message_channel"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "639265817d2f4627ab49f8ffaae087f7",
      "localConnectionString": "postgresql://postgres:postgres@localhost:5432/payload"
    }
  ],
  "vars": {
    "S3_BUCKET": "media",
    "S3_REGION": "ca-central-1",
    "S3_ENDPOINT": "https://gnoubqtrwlnsfeolpari.storage.supabase.co/storage/v1/s3",
    "NEXT_PUBLIC_SERVER_URL": "https://amn-sk-cms.mrbraddavidson.workers.dev",
    "CORS_ORIGINS": "https://amn-sk.pages.dev,http://localhost:4321"
  }
}
