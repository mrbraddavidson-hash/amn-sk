{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amn-sk-web",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  }
}
