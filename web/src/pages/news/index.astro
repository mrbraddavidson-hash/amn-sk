---
import Layout from '../../layouts/Layout.astro';
import { getNews } from '../../lib/cms';

const news = await getNews();
---

<Layout title="News & Updates — Mentor Network (AMN-SK)">
  <section class="bg-gradient-to-b from-sky-900 to-slate-900 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-xs font-bold uppercase tracking-wider text-sky-300">Announcements</span>
      <h1 class="text-4xl font-extrabold tracking-tight mt-2 text-white">News & Updates</h1>
      <p class="text-lg text-sky-100/90 mt-4 max-w-2xl leading-relaxed">
        Stay up to date with cohorts, mentorship milestones, and healthcare community developments.
      </p>
    </div>
  </section>

  <section class="py-16 bg-slate-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      {news.map((item) => (
        <article class="bg-white rounded-2xl p-8 border border-slate-200 shadow-xs hover:border-sky-300 transition-colors">
          <div class="flex items-center gap-3 text-xs text-slate-500 font-medium mb-3">
            <span>📅 {item.publishedDate}</span>
            {item.isFeatured && (
              <span class="px-2 py-0.5 rounded bg-amber-100 text-amber-800 font-semibold font-mono text-[10px]">
                FEATURED
              </span>
            )}
          </div>
          <h2 class="text-2xl font-bold text-slate-900 hover:text-sky-700 transition-colors">
            {item.title}
          </h2>
          <p class="text-base text-slate-600 mt-3 leading-relaxed">
            {item.excerpt}
          </p>
        </article>
      ))}
    </div>
  </section>
</Layout>
