---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Membership Request — Mentor Network (AMN-SK)">
  <section class="bg-gradient-to-b from-sky-900 to-slate-900 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-xs font-bold uppercase tracking-wider text-sky-300">Intake & Application</span>
      <h1 class="text-4xl font-extrabold tracking-tight mt-2 text-white">Join the Mentor Network</h1>
      <p class="text-lg text-sky-100/90 mt-4 max-w-2xl leading-relaxed">
        Apply to participate as an accredited clinical mentor or mentee in Saskatchewan. Our administrative team reviews submissions continuously.
      </p>
    </div>
  </section>

  <section class="py-16 bg-slate-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-2xl p-8 sm:p-10 border border-slate-200 shadow-sm">
        
        <!-- Success State Container (Hidden initially) -->
        <div id="success-message" class="hidden p-6 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-900 text-center space-y-3">
          <div class="w-12 h-12 bg-emerald-100 text-emerald-700 rounded-full flex items-center justify-center mx-auto text-2xl font-bold">
            ✓
          </div>
          <h2 class="text-xl font-bold">Membership Request Submitted Successfully!</h2>
          <p class="text-sm text-emerald-800 leading-relaxed max-w-lg mx-auto">
            Thank you for applying to the Mentor Network (AMN-SK). A confirmation email has been logged, and our network coordinators will review your clinical focus and contact you regarding partnership matching.
          </p>
          <div class="pt-4">
            <a href="/" class="inline-block px-5 py-2.5 rounded-lg bg-emerald-700 hover:bg-emerald-800 text-white text-sm font-semibold transition-colors">
              Return to Homepage
            </a>
          </div>
        </div>

        <!-- Intake Form -->
        <form id="membership-form" class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <h2 class="text-xl font-bold text-slate-900">Applicant Information</h2>
            <p class="text-xs text-slate-500 mt-1">Please provide your contact and practice details.</p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="fullName" class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5">
                Full Legal / Professional Name <span class="text-rose-500">*</span>
              </label>
              <input 
                type="text" 
                id="fullName" 
                name="fullName" 
                required 
                placeholder="Dr. Jane Smith"
                class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-sky-500 focus:ring-1 focus:ring-sky-500 text-sm"
              />
            </div>

            <div>
              <label for="email" class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5">
                Professional Email Address <span class="text-rose-500">*</span>
              </label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required 
                placeholder="jane.smith@saskhealthauthority.ca"
                class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-sky-500 focus:ring-1 focus:ring-sky-500 text-sm"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="phone" class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5">
                Phone Number
              </label>
              <input 
                type="tel" 
                id="phone" 
                name="phone" 
                placeholder="(306) 555-0199"
                class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-sky-500 focus:ring-1 focus:ring-sky-500 text-sm"
              />
            </div>

            <div>
              <label for="requestedRole" class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5">
                Application Track <span class="text-rose-500">*</span>
              </label>
              <select 
                id="requestedRole" 
                name="requestedRole" 
                required
                class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-sky-500 focus:ring-1 focus:ring-sky-500 text-sm bg-white"
              >
                <option value="mentee">Prospective Mentee (Seeking Mentorship)</option>
                <option value="mentor">Prospective Mentor (Providing Mentorship)</option>
              </select>
            </div>
          </div>

          <div>
            <label for="organization" class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5">
              Practice Location & Organization
            </label>
            <input 
              type="text" 
              id="organization" 
              name="organization" 
              placeholder="e.g. Swift Current Rural Clinic, SHA, or Regina General"
              class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-sky-500 focus:ring-1 focus:ring-sky-500 text-sm"
            />
          </div>

          <div>
            <label for="clinicalBackground" class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5">
              Clinical Background & Specialization
            </label>
            <textarea 
              id="clinicalBackground" 
              name="clinicalBackground" 
              rows="2" 
              placeholder="e.g. 2nd-year Family Medicine Resident focusing on rural emergency care"
              class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-sky-500 focus:ring-1 focus:ring-sky-500 text-sm"
            ></textarea>
          </div>

          <div>
            <label for="statementOfInterest" class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5">
              Statement of Interest / Goals <span class="text-rose-500">*</span>
            </label>
            <textarea 
              id="statementOfInterest" 
              name="statementOfInterest" 
              rows="4" 
              required 
              placeholder="Describe what you hope to achieve through the Mentor Network..."
              class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-sky-500 focus:ring-1 focus:ring-sky-500 text-sm"
            ></textarea>
          </div>

          <div id="error-message" class="hidden p-3 rounded-lg bg-rose-50 border border-rose-200 text-rose-700 text-xs">
          </div>

          <div class="pt-4">
            <button 
              type="submit" 
              id="submit-btn"
              class="w-full py-3.5 px-6 rounded-xl font-bold text-white bg-sky-700 hover:bg-sky-800 shadow-md transition-all flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>Submit Membership Application</span>
            </button>
          </div>
        </form>

      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('membership-form') as HTMLFormElement;
    const successMsg = document.getElementById('success-message');
    const errorMsg = document.getElementById('error-message');
    const submitBtn = document.getElementById('submit-btn');

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (errorMsg) errorMsg.classList.add('hidden');
        if (submitBtn) {
          submitBtn.setAttribute('disabled', 'true');
          submitBtn.textContent = 'Submitting Application...';
        }

        const formData = new FormData(form);
        const payload = {
          fullName: formData.get('fullName'),
          email: formData.get('email'),
          phone: formData.get('phone'),
          requestedRole: formData.get('requestedRole'),
          organization: formData.get('organization'),
          clinicalBackground: formData.get('clinicalBackground'),
          statementOfInterest: formData.get('statementOfInterest'),
          status: 'pending',
        };

        try {
          const res = await fetch('https://amn-sk-cms.mrbraddavidson.workers.dev/api/membership-requests', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(payload),
          });

          if (!res.ok) {
            const errData = await res.json();
            throw new Error(errData?.errors?.[0]?.message || 'Failed to submit application. Please verify your details.');
          }

          form.classList.add('hidden');
          if (successMsg) successMsg.classList.remove('hidden');
        } catch (err: any) {
          if (errorMsg) {
            errorMsg.textContent = err.message || 'An error occurred. Please try again or contact the network directly.';
            errorMsg.classList.remove('hidden');
          }
          if (submitBtn) {
            submitBtn.removeAttribute('disabled');
            submitBtn.textContent = 'Submit Membership Application';
          }
        }
      });
    }
  </script>
</Layout>
