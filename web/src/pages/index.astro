---
import Layout from '../layouts/Layout.astro';
import { getQuotes, getFAQs, getNews, getEvents } from '../lib/cms';

const quotes = await getQuotes();
const faqs = await getFAQs();
const news = await getNews();
const events = await getEvents();
---

<Layout title="Mentor Network (AMN-SK) — Supporting Saskatchewan Clinical Leaders">
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-sky-900 via-sky-800 to-slate-900 text-white overflow-hidden py-20 lg:py-28">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:16px_16px]"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-700/60 border border-sky-500/30 text-sky-200 text-xs font-medium mb-6">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          2026/2027 Mentorship Intake Now Open
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-tight mb-6">
          Connecting, Guiding & Strengthening Saskatchewan’s Healthcare Community.
        </h1>
        <p class="text-lg sm:text-xl text-sky-100/90 leading-relaxed mb-8">
          The Mentor Network (AMN-SK) provides a public-facing knowledge base for patients and providers, paired with a secure, accredited mentorship community for rural and urban clinicians.
        </p>
        <div class="flex flex-wrap items-center gap-4">
          <a 
            href="/apply" 
            class="px-6 py-3.5 rounded-xl font-semibold text-white bg-sky-500 hover:bg-sky-400 shadow-lg shadow-sky-900/40 transition-all text-base flex items-center gap-2"
          >
            <span>Request Membership</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <a 
            href="/resources" 
            class="px-6 py-3.5 rounded-xl font-semibold text-white bg-white/10 hover:bg-white/20 border border-white/20 transition-all text-base"
          >
            Explore Public Resources
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Funder / Financial Support Banner -->
  <section class="bg-white border-b border-slate-200 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="md:w-1/3">
          <span class="text-xs font-bold uppercase tracking-wider text-sky-800 block">Financial Support & Collaboration</span>
          <p class="text-xs text-slate-500 mt-1">Supported through provincial healthcare grants, continuing professional development, and physician support funds.</p>
        </div>
        <div class="md:w-2/3 flex flex-wrap items-center justify-start md:justify-end gap-6 sm:gap-10 opacity-75 grayscale hover:grayscale-0 transition-all">
          <div class="text-slate-700 font-bold tracking-tight text-sm flex items-center gap-2">
            <div class="w-3 h-3 rounded-full bg-sky-700"></div> Saskatchewan Health Authority Partners
          </div>
          <div class="text-slate-700 font-bold tracking-tight text-sm flex items-center gap-2">
            <div class="w-3 h-3 rounded-full bg-teal-600"></div> Clinical Mentorship Grant Fund
          </div>
          <div class="text-slate-700 font-bold tracking-tight text-sm flex items-center gap-2">
            <div class="w-3 h-3 rounded-full bg-slate-800"></div> Continuing Medical Education
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Four Access Pillars -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-3xl font-bold text-slate-900 tracking-tight">Structured For Every Role in Our System</h2>
        <p class="text-slate-600 mt-3 text-base">Public guides for patients and providers, plus confidential, role-gated portals for active mentorship partnerships.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Card 1: Health Providers -->
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-2xs hover:shadow-md transition-shadow flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-sky-100 text-sky-700 flex items-center justify-center font-bold text-lg mb-4">
              🩺
            </div>
            <span class="text-xs font-semibold px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 font-mono">Public Access</span>
            <h3 class="text-xl font-bold text-slate-900 mt-2">Health Providers</h3>
            <p class="text-sm text-slate-600 mt-2 leading-relaxed">
              Clinical checklists, rural practice orientation guides, interprofessional protocols, and CME event information.
            </p>
          </div>
          <a href="/resources#providers" class="mt-6 text-sm font-semibold text-sky-700 hover:text-sky-800 inline-flex items-center gap-1">
            Browse Provider Tools →
          </a>
        </div>

        <!-- Card 2: Patients -->
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-2xs hover:shadow-md transition-shadow flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-teal-100 text-teal-700 flex items-center justify-center font-bold text-lg mb-4">
              🤝
            </div>
            <span class="text-xs font-semibold px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 font-mono">Public Access</span>
            <h3 class="text-xl font-bold text-slate-900 mt-2">Patient Resources</h3>
            <p class="text-sm text-slate-600 mt-2 leading-relaxed">
              Clear, patient-centered guides on navigating healthcare teams, virtual care pathways, and chronic illness coordination.
            </p>
          </div>
          <a href="/resources#patients" class="mt-6 text-sm font-semibold text-teal-700 hover:text-teal-800 inline-flex items-center gap-1">
            Access Patient Guides →
          </a>
        </div>

        <!-- Card 3: Mentors -->
        <div class="bg-white rounded-2xl p-6 border border-sky-200 shadow-2xs hover:shadow-md transition-shadow flex flex-col justify-between relative overflow-hidden">
          <div class="absolute top-0 right-0 bg-sky-600 text-white text-[10px] font-bold px-3 py-1 rounded-bl-lg">
            MEMBER ONLY
          </div>
          <div>
            <div class="w-12 h-12 rounded-xl bg-sky-700 text-white flex items-center justify-center font-bold text-lg mb-4">
              🧭
            </div>
            <span class="text-xs font-semibold px-2 py-0.5 rounded bg-amber-100 text-amber-800 font-mono">Login Required</span>
            <h3 class="text-xl font-bold text-slate-900 mt-2">Mentor Portal</h3>
            <p class="text-sm text-slate-600 mt-2 leading-relaxed">
              Confidential coaching toolkits, meeting frameworks, leadership resources, and private discussion documentation.
            </p>
          </div>
          <a href="/login" class="mt-6 text-sm font-semibold text-sky-700 hover:text-sky-800 inline-flex items-center gap-1">
            Sign In as Mentor →
          </a>
        </div>

        <!-- Card 4: Mentees -->
        <div class="bg-white rounded-2xl p-6 border border-teal-200 shadow-2xs hover:shadow-md transition-shadow flex flex-col justify-between relative overflow-hidden">
          <div class="absolute top-0 right-0 bg-teal-600 text-white text-[10px] font-bold px-3 py-1 rounded-bl-lg">
            MEMBER ONLY
          </div>
          <div>
            <div class="w-12 h-12 rounded-xl bg-teal-700 text-white flex items-center justify-center font-bold text-lg mb-4">
              🌱
            </div>
            <span class="text-xs font-semibold px-2 py-0.5 rounded bg-amber-100 text-amber-800 font-mono">Login Required</span>
            <h3 class="text-xl font-bold text-slate-900 mt-2">Mentee Portal</h3>
            <p class="text-sm text-slate-600 mt-2 leading-relaxed">
              Career milestone roadmaps, transition toolkits, onboarding templates, and direct access to assigned mentor contact info.
            </p>
          </div>
          <a href="/login" class="mt-6 text-sm font-semibold text-teal-700 hover:text-teal-800 inline-flex items-center gap-1">
            Sign In as Mentee →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Rotating Statements & Quotes Section -->
  <section class="py-16 bg-white border-y border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-10">
        <span class="text-xs font-bold uppercase tracking-wider text-sky-700">Member Voices</span>
        <h2 class="text-3xl font-bold text-slate-900 tracking-tight mt-1">Experiences Across Saskatchewan</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {quotes.map((q) => (
          <div class="bg-slate-50 rounded-2xl p-8 border border-slate-200/80 flex flex-col justify-between shadow-xs">
            <blockquote class="text-slate-700 text-base italic leading-relaxed mb-6">
              "{q.quote}"
            </blockquote>
            <div class="pt-4 border-t border-slate-200">
              <p class="font-bold text-slate-900 text-sm">{q.author}</p>
              <p class="text-xs text-slate-500 mt-0.5">{q.roleOrAffiliation}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- News & Upcoming Events Preview -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-10 gap-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-sky-700">Latest Updates</span>
          <h2 class="text-3xl font-bold text-slate-900 tracking-tight mt-1">News & Upcoming Events</h2>
        </div>
        <div class="flex items-center gap-4">
          <a href="/news" class="text-sm font-semibold text-sky-700 hover:underline">View all news →</a>
          <a href="/events" class="text-sm font-semibold text-sky-700 hover:underline">View all events →</a>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- News Column -->
        <div class="space-y-4">
          <h3 class="text-lg font-bold text-slate-900 flex items-center gap-2">
            <span>📰 Recent News</span>
          </h3>
          {news.slice(0, 2).map((item) => (
            <article class="bg-white rounded-xl p-6 border border-slate-200 shadow-2xs hover:border-sky-300 transition-colors">
              <div class="text-xs text-slate-500 font-medium mb-2">{item.publishedDate}</div>
              <h4 class="text-lg font-bold text-slate-900 hover:text-sky-700">
                <a href={`/news`}>{item.title}</a>
              </h4>
              <p class="text-sm text-slate-600 mt-2 leading-relaxed">{item.excerpt}</p>
            </article>
          ))}
        </div>

        <!-- Events Column -->
        <div class="space-y-4">
          <h3 class="text-lg font-bold text-slate-900 flex items-center gap-2">
            <span>📅 Upcoming Workshops & Sessions</span>
          </h3>
          {events.slice(0, 2).map((item) => (
            <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-2xs hover:border-sky-300 transition-colors">
              <div class="flex items-center gap-2 mb-2">
                <span class="text-xs font-semibold px-2 py-0.5 rounded bg-sky-100 text-sky-800 uppercase font-mono">
                  {item.locationType}
                </span>
                <span class="text-xs text-slate-500 font-medium">{new Date(item.eventDate).toLocaleDateString()}</span>
              </div>
              <h4 class="text-lg font-bold text-slate-900">{item.title}</h4>
              <p class="text-sm text-slate-600 mt-2 leading-relaxed">{item.description}</p>
              {item.locationDetails && (
                <div class="mt-3 text-xs text-slate-500 flex items-center gap-1.5 font-medium">
                  <span>📍 {item.locationDetails}</span>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Frequently Asked Questions -->
  <section class="py-16 bg-white border-t border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="text-xs font-bold uppercase tracking-wider text-sky-700">Common Inquiries</span>
        <h2 class="text-3xl font-bold text-slate-900 tracking-tight mt-1">Frequently Asked Questions</h2>
        <p class="text-slate-600 mt-2 text-sm">Everything you need to know about joining, participation requirements, and resource access.</p>
      </div>

      <div class="space-y-4">
        {faqs.map((faq, i) => (
          <details class="group bg-slate-50 rounded-xl p-6 border border-slate-200 open:bg-sky-50/50 open:border-sky-200 transition-all">
            <summary class="font-bold text-slate-900 text-base cursor-pointer list-none flex justify-between items-center focus:outline-hidden">
              <span>{faq.question}</span>
              <span class="text-slate-400 group-open:rotate-180 transition-transform ml-4">
                ▼
              </span>
            </summary>
            <p class="mt-4 text-sm text-slate-600 leading-relaxed pt-2 border-t border-slate-200/60">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Call To Action Footer Banner -->
  <section class="py-16 bg-gradient-to-r from-sky-800 to-teal-800 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl">
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4">
        Ready to Connect With a Saskatchewan Peer?
      </h2>
      <p class="text-sky-100 text-base sm:text-lg mb-8 leading-relaxed">
        Whether you are seeking mentorship for your clinical transition or looking to share your experience as an accredited mentor, our network welcomes you.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a 
          href="/apply" 
          class="px-8 py-3.5 rounded-xl font-bold text-sky-900 bg-white hover:bg-sky-50 shadow-md transition-all text-base"
        >
          Submit Membership Request
        </a>
        <a 
          href="/about" 
          class="px-8 py-3.5 rounded-xl font-bold text-white bg-sky-900/40 hover:bg-sky-900/60 border border-white/20 transition-all text-base"
        >
          Learn More About Our Mission
        </a>
      </div>
    </div>
  </section>
</Layout>
