---
import Layout from '../../layouts/Layout.astro';
import { getPublicResources } from '../../lib/cms';

const providerResources = await getPublicResources('health-provider');
const patientResources = await getPublicResources('patient');
---

<Layout title="Resources — Mentor Network (AMN-SK)">
  <section class="bg-gradient-to-b from-sky-900 to-slate-900 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-xs font-bold uppercase tracking-wider text-sky-300">Resource Repository</span>
      <h1 class="text-4xl font-extrabold tracking-tight mt-2 text-white">Clinical & Community Resources</h1>
      <p class="text-lg text-sky-100/90 mt-4 max-w-2xl leading-relaxed">
        Curated toolkits, transition checklists, and educational guides for Saskatchewan healthcare providers, patients, and network members.
      </p>
    </div>
  </section>

  <section class="py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <!-- Section 1: Health Provider Resources (Public) -->
      <div id="providers">
        <div class="flex items-center justify-between mb-8 pb-4 border-b border-slate-200">
          <div>
            <div class="inline-flex items-center gap-2 mb-1">
              <span class="text-xl">🩺</span>
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 font-mono">PUBLIC ACCESS</span>
            </div>
            <h2 class="text-2xl font-bold text-slate-900 tracking-tight">Health Provider Resources</h2>
            <p class="text-sm text-slate-600 mt-1">Tools and frameworks for physicians, residents, and multidisciplinary healthcare teams.</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {providerResources.map((res) => (
            <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-2xs flex flex-col justify-between">
              <div>
                <span class="text-xs text-slate-400 font-medium">{res.publishedDate}</span>
                <h3 class="text-lg font-bold text-slate-900 mt-1">{res.title}</h3>
                <p class="text-sm text-slate-600 mt-2 leading-relaxed">{res.description}</p>
              </div>
              <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
                <span class="text-xs text-slate-500 font-mono">Format: Clinical Guide (PDF)</span>
                <a href="#providers" class="text-xs font-bold text-sky-700 hover:text-sky-800 flex items-center gap-1">
                  <span>Download Resource</span> ↓
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Section 2: Patient Resources (Public) -->
      <div id="patients">
        <div class="flex items-center justify-between mb-8 pb-4 border-b border-slate-200">
          <div>
            <div class="inline-flex items-center gap-2 mb-1">
              <span class="text-xl">🤝</span>
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 font-mono">PUBLIC ACCESS</span>
            </div>
            <h2 class="text-2xl font-bold text-slate-900 tracking-tight">Patient & Community Resources</h2>
            <p class="text-sm text-slate-600 mt-1">Plain-language guides supporting patient empowerment, care team navigation, and health advocacy.</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {patientResources.map((res) => (
            <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-2xs flex flex-col justify-between">
              <div>
                <span class="text-xs text-slate-400 font-medium">{res.publishedDate}</span>
                <h3 class="text-lg font-bold text-slate-900 mt-1">{res.title}</h3>
                <p class="text-sm text-slate-600 mt-2 leading-relaxed">{res.description}</p>
              </div>
              <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
                <span class="text-xs text-slate-500 font-mono">Format: Patient Guide</span>
                <a href="#patients" class="text-xs font-bold text-teal-700 hover:text-teal-800 flex items-center gap-1">
                  <span>Download Guide</span> ↓
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Section 3: Restricted Member Resources Notice -->
      <div class="bg-gradient-to-br from-slate-900 to-sky-950 rounded-2xl p-8 sm:p-10 text-white shadow-lg border border-slate-800">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-400/20 text-amber-300 border border-amber-400/30 text-xs font-semibold font-mono mb-4">
            🔒 RESTRICTED MEMBER ACCESS
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white mb-3">
            Looking for Mentor & Mentee Toolkits?
          </h2>
          <p class="text-sm sm:text-base text-slate-300 leading-relaxed mb-6">
            Confidential mentorship frameworks, partnership milestone logs, clinical orientation toolkits, and peer coaching modules are housed inside the secure member area. Only authenticated active mentors and mentees can access and download these files.
          </p>
          <div class="flex flex-wrap items-center gap-4">
            <a 
              href="/login" 
              class="px-5 py-2.5 rounded-lg font-semibold text-sm bg-sky-500 hover:bg-sky-400 text-white transition-colors"
            >
              Member Sign In
            </a>
            <a 
              href="/apply" 
              class="px-5 py-2.5 rounded-lg font-semibold text-sm bg-white/10 hover:bg-white/20 text-white border border-white/20 transition-colors"
            >
              Apply for Network Membership
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>
</Layout>
