---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Reset Password — Mentor Network (AMN-SK)">
  <section class="min-h-[80vh] flex items-center justify-center py-16 bg-slate-50">
    <div class="w-full max-w-md px-4">
      <div class="bg-white rounded-2xl p-8 sm:p-10 border border-slate-200 shadow-md">
        <div class="text-center mb-8">
          <div class="w-12 h-12 bg-sky-700 text-white rounded-xl flex items-center justify-center font-bold text-xl mx-auto mb-3 shadow-sm">
            MN
          </div>
          <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Reset Your Password</h1>
          <p class="text-xs text-slate-500 mt-1">We'll email you a link to choose a new one</p>
        </div>

        <form id="forgot-form" class="space-y-4">
          <div>
            <label for="email" class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1">Email Address</label>
            <input type="email" id="email" name="email" required placeholder="name@organization.ca"
              class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-sky-500 focus:ring-1 focus:ring-sky-500 text-sm" />
          </div>
          <div id="forgot-message" role="status" class="hidden p-3 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs font-medium">
            If that email belongs to a member account, a reset link is on its way.
          </div>
          <button type="submit" id="forgot-btn"
            class="w-full py-3 px-4 rounded-xl font-bold text-white bg-sky-700 hover:bg-sky-800 shadow-sm transition-all text-sm cursor-pointer mt-2">
            Send Reset Link
          </button>
        </form>

        <div class="mt-6 pt-6 border-t border-slate-100 text-center">
          <a href="/login" class="text-xs font-bold text-sky-700 hover:text-sky-800">← Back to sign in</a>
        </div>
      </div>
    </div>
  </section>

  <script>
    const CMS_URL = 'https://cms-rho-sooty.vercel.app';
    const form = document.getElementById('forgot-form') as HTMLFormElement;
    const message = document.getElementById('forgot-message');
    const btn = document.getElementById('forgot-btn') as HTMLButtonElement;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      btn.disabled = true;
      btn.textContent = 'Sending…';
      const email = new FormData(form).get('email');
      try {
        await fetch(`${CMS_URL}/api/users/forgot-password`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
      } catch {
        // Same message either way so account existence is not revealed
      }
      message?.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = 'Send Reset Link';
    });
  </script>
</Layout>
